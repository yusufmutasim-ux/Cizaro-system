# Claude API key (console.anthropic.com). Can also be set from the Settings page.
ANTHROPIC_API_KEY=""

# Higgsfield MCP server: URL and access token. Can also be set from the Settings page.
HIGGSFIELD_MCP_URL=""
HIGGSFIELD_MCP_TOKEN=""

# Public address of this app (e.g. https://designer.example.com). Lets Higgsfield fetch your logo,
# product photos and reference images when it generates. Leave empty when running locally.
APP_URL=""

# Password to open the app. Leave empty to run without a login (local use only).
APP_PASSWORD=""
# Long random string used to sign the login cookie and public file links (openssl rand -base64 32)
SESSION_SECRET="change-me-to-a-long-random-string"

DATABASE_URL="file:./designer.db"
STORAGE_DIR="./storage"
