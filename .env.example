# SQLite file for local/single-server use. For Postgres, change provider in prisma/schema.prisma
DATABASE_URL="file:./cizaro.db"

# Long random string used to sign login sessions (e.g. `openssl rand -base64 32`)
SESSION_SECRET="change-me-to-a-long-random-string"

# Where uploaded design files are stored on disk
STORAGE_DIR="./storage"

# First manager account, created by `npm run seed`
ADMIN_NAME="Yusuf"
ADMIN_EMAIL="admin@cizaro.com"
ADMIN_PASSWORD="change-me"
