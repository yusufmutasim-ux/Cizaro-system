// SQLite works out of the box on a single server.
// For Vercel or a managed host, switch provider to "postgresql" and point DATABASE_URL at Postgres.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("DESIGNER") // MANAGER | DESIGNER
  active       Boolean    @default(true)
  locale       String     @default("ar") // ar | en, also used for notifications
  createdAt    DateTime   @default(now())
  assigned     Task[]     @relation("assignee")
  created      Task[]     @relation("creator")
  activity     Activity[]
  files        File[]
  pushSubs     PushSubscription[]
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  brief       String     @default("")
  type        String     @default("social")
  size        String     @default("")
  due         String?    // YYYY-MM-DD
  priority    String     @default("normal") // low | normal | high | urgent
  status      String     @default("new") // new | doing | review | changes | done
  revisions   Int        @default(0)
  coverFileId String?
  assigneeId  String?
  assignee    User?      @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User       @relation("creator", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  doneAt      DateTime?
  activity    Activity[]
  files       File[]

  @@index([status])
  @@index([assigneeId])
}

model Activity {
  id        String   @id @default(cuid())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String   // created | status | comment | submitted | changes | approved | file
  text      String?
  toStatus  String?
  round     Int?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model File {
  id           String   @id @default(cuid())
  taskId       Int
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  slot         String   // ref | delivery
  kind         String   // upload | link
  name         String
  url          String?  // for links
  storageKey   String?  // for uploads, relative to STORAGE_DIR
  mime         String?
  size         Int?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([taskId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Small key/value store (holds the auto-generated VAPID keys for push notifications)
model Setting {
  key   String @id
  value String
}
